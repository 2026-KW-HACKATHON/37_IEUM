VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
# 로컬 시연 모드의 /admin 진입 정보입니다. VITE_ 값은 브라우저에 공개되므로 실제 인증에 사용하지 마세요.
VITE_DEMO_ADMIN_ID=your-demo-admin-id
VITE_DEMO_ADMIN_PASSWORD=your-demo-admin-password
# 로컬 브라우저 저장소로 테스트하려면 true로 설정합니다. Supabase 연결이 비활성화됩니다.
# VITE_USE_LOCAL_STORAGE=true
